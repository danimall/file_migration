# Copy to .env and fill in. NEVER commit .env.
# .env is git-ignored. These are read by filemig.config.Settings.

# ---- Dropbox app (App Console -> scoped app, Full Dropbox) ----
# Read-only scopes required: files.metadata.read files.content.read
FILEMIG_DROPBOX_APP_KEY=
FILEMIG_DROPBOX_APP_SECRET=

# ---- Google OAuth client (GCP -> Credentials -> OAuth client -> Desktop app) ----
# Consent screen scope: https://www.googleapis.com/auth/drive.file
# IMPORTANT: publish the consent screen to "Production" so refresh tokens do
# not expire after 7 days (the Testing-mode trap). drive.file is non-sensitive,
# so Production needs no Google verification.
FILEMIG_GOOGLE_CLIENT_ID=
FILEMIG_GOOGLE_CLIENT_SECRET=

# ---- Server (loopback only; remote binding is intentionally rejected) ----
FILEMIG_HOST=127.0.0.1
FILEMIG_PORT=8765

# ---- Storage paths (defaults derive from the config dir if unset) ----
# FILEMIG_DATA_DIR=/Users/you/.filemig
# FILEMIG_STAGING_DIR=/Users/you/.filemig/staging

# ---- Tuning (optional; sane defaults in config.py) ----
# FILEMIG_WORKER_CONCURRENCY=2
# FILEMIG_UPLOAD_CHUNK_BYTES=33554432         # 32 MiB (must be 256 KiB multiple)
# FILEMIG_DAILY_CAP_BYTES=805306368000        # 750 GiB hard cap
# FILEMIG_DAILY_CAP_MARGIN=0.05               # ~5% safety -> ~712 GiB effective
# FILEMIG_BATCH_TARGET_BYTES=107374182400     # ~100 GiB per proposed batch
# FILEMIG_BATCH_FILE_LIMIT=2000
# FILEMIG_STAGING_MIN_FREE_BYTES=107374182400 # keep ~100 GiB free
